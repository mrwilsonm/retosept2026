{
  "name": "reto-02-contratos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "build": "tsc && vite build web --config web/vite.config.ts",
    "dev": "npm run build && node dist/src/server.js",
    "dev:watch": "npm run build && node --watch dist/src/server.js",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --import tsx demo.ts",
    "test:e2e": "npm run build && playwright test",
    "reset:demo": "node scripts/reset-demo.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
